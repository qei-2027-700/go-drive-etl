POSTGRES_DSN=postgres://app:password@localhost:5432/app_db?sslmode=disable

# My Drive にレポートを出力する場合の OAuth 2.0 ユーザー認証。
# cmd/auth を実行して GOOGLE_REFRESH_TOKEN を取得する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Firestore を使う場合に必要
GOOGLE_CLOUD_PROJECT=

# Drive API 認証: サービスアカウント方式（デフォルト）
# サービスアカウントの JSON キーへのパスを指定する。JSON キーはパスワード同等の機密情報なので
# リポジトリ外に置き、.gitignore で除外すること。
GOOGLE_APPLICATION_CREDENTIALS=

# Drive API は GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN の
# すべてを設定すると OAuth ユーザー認証を優先し、未設定ならサービスアカウントを使う。

BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=
# CSV 出力対象の Gold dataset（省略時: etl_gold）
BIGQUERY_GOLD_DATASET_ID=etl_gold
DRIVE_FOLDER_ID=
# Drive の /export-reports/ フォルダ ID。設定すると Gold Mart CSV を同名で更新する。
DRIVE_EXPORT_FOLDER_ID=
# 状態管理のバックエンド: postgres | firestore（省略時は firestore）
# この例で postgres にしているのは、GCP の設定なしで動く方を新規セットアップの初手にするため。
# Firestore を使うときは firestore にするか、この行を消す。
STATE_BACKEND=postgres

# ローカルで Firestore エミュレータ（docker compose up -d firestore）を使う場合のみ設定する。
# 設定するとクライアントライブラリが自動でエミュレータへ向き、GCP 認証も課金も発生しない。
# 本番の Firestore に接続するときは必ず空にすること。
# FIRESTORE_EMULATOR_HOST=localhost:8080

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Deployments should set this to the Git commit SHA. It can also be embedded
# with: go build -ldflags "-X main.buildRelease=<commit-sha>" ./cmd/worker
SENTRY_RELEASE=
