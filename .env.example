POSTGRES_DSN=postgres://app:password@localhost:5432/app_db?sslmode=disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=
DRIVE_FOLDER_ID=
# 状態管理のバックエンド: postgres | firestore（省略時は firestore）
# この例で postgres にしているのは、GCP の設定なしで動く方を新規セットアップの初手にするため。
# Firestore を使うときは firestore にするか、この行を消す。
STATE_BACKEND=postgres

# Firestore を使う場合に必要
GOOGLE_CLOUD_PROJECT=

# ローカルで Firestore エミュレータ（docker compose up -d firestore）を使う場合のみ設定する。
# 設定するとクライアントライブラリが自動でエミュレータへ向き、GCP 認証も課金も発生しない。
# 本番の Firestore に接続するときは必ず空にすること。
# FIRESTORE_EMULATOR_HOST=localhost:8080
