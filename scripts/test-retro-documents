#!/usr/bin/env python3
"""Emit a synthetic BigQuery assertion script using the actual Terraform SQL.

No production tables are read or changed. Pipe stdout to bq query with
--use_legacy_sql=false to execute the assertions in temporary tables.
"""

from pathlib import Path
import re
import runpy
import sys

ROOT = Path(__file__).resolve().parent.parent


def substitute_tables(query, before=False):
    suffix = "_before" if before else ""
    for reference, table in (
        ("`${var.project_id}.${google_bigquery_dataset.etl.dataset_id}.chunks`", "chunks"),
        ("`${var.project_id}.${google_bigquery_dataset.etl.dataset_id}.chunks_current`", "chunks_current"),
        ("`${var.project_id}.${google_bigquery_dataset.silver.dataset_id}.silver_chunks`", "silver_chunks"),
    ):
        query = query.replace(reference, table if table == "chunks" else table + suffix)
    if "${" in query:
        raise ValueError("Unresolved Terraform interpolation")
    return query


def view_query(path, resource):
    text = (ROOT / path).read_text()
    block = text.split(f'resource "google_bigquery_table" "{resource}" {{', 1)[1]
    match = re.search(r"query\s*=\s*<<-SQL\n(.*?)\n\s*SQL", block, re.S)
    if match is None:
        raise ValueError(f"Missing SQL for {resource}")
    query = match.group(1)
    return substitute_tables(query)


def main():
    print("""-- Synthetic fixtures only; all tables are temporary.
CREATE TEMP TABLE chunks AS
WITH fixtures AS (
SELECT *
FROM UNNEST(ARRAY<STRUCT<
  file_id STRING, chunk_index INT64, content STRING, embedding_status STRING,
  content_version STRING, ingested_at TIMESTAMP, is_deleted BOOL,
  document_name STRING, drive_url STRING,
  reflection_month STRING, reflection_sequence INT64
>>[
  ('renamed', 0, 'obsolete', 'pending', 'v1', '2026-10-01', FALSE, 'old', 'old-url', '2026-09', 1),
  ('renamed', 1, 'second', 'pending', 'v2', '2026-10-02', FALSE, 'before', 'before-url', '2026-10', 2),
  ('renamed', 0, 'first', 'pending', 'v2', '2026-10-02', FALSE, 'before', 'before-url', '2026-10', 2),
  ('renamed', 1, 'second', 'pending', 'v2', '2026-10-03', FALSE, 'after', 'after-url', '2026-10', 2),
  ('renamed', 0, 'first', 'pending', 'v2', '2026-10-03', FALSE, 'after', 'after-url', '2026-10', 2),
  ('renamed', 0, 'first', 'pending', 'v2', '2026-10-03', FALSE, 'after', 'after-url', '2026-10', 2),
  ('empty', 0, 'previous body', 'pending', 'v1', '2026-10-01', FALSE, 'empty', 'empty-url', '2026-10', 1),
  ('empty', 0, '', 'pending', 'v2', '2026-10-02', TRUE, 'empty', 'empty-url', NULL, NULL),
  ('unknown', 0, 'unknown month', 'pending', 'v1', '2026-10-01', FALSE, NULL, NULL, NULL, NULL),
  ('cleared', 0, 'same body', 'pending', 'v1', '2026-10-01', FALSE, 'before', 'before-url', '2026-10', 3),
  ('cleared', 0, 'same body', 'pending', 'v1', '2026-10-02', FALSE, NULL, NULL, NULL, NULL),
  ('long', 1, 'continuation', 'pending', 'v1', '2026-10-01', FALSE, 'long', 'long-url', '2026-10', 4),
  ('long', 0, REPEAT('あ', 4000), 'pending', 'v1', '2026-10-01', FALSE, 'long', 'long-url', '2026-10', 4),
  ('cross-month', 0, 'cross month sprint', 'pending', 'v1', '2026-10-01', FALSE, 'cross month', 'synthetic-url', '2026-09', 4)
]))
-- Period metadata can change while content_version stays unchanged. Use
-- SELECT fixtures instead of DML so this also works in BigQuery Sandbox.
SELECT *,
  CASE
    WHEN file_id = 'cross-month' THEN DATE '2026-09-28'
    WHEN file_id = 'renamed' AND ingested_at = TIMESTAMP '2026-10-03' THEN DATE '2026-10-12'
    WHEN file_id IN ('renamed', 'cleared', 'empty') AND ingested_at = TIMESTAMP '2026-10-01' THEN DATE '2026-10-05'
    WHEN file_id = 'renamed' THEN DATE '2026-10-05'
  END AS reflection_start_date,
  CASE
    WHEN file_id = 'cross-month' THEN DATE '2026-10-04'
    WHEN file_id = 'renamed' AND ingested_at = TIMESTAMP '2026-10-03' THEN DATE '2026-10-18'
    WHEN file_id IN ('renamed', 'cleared', 'empty') AND ingested_at = TIMESTAMP '2026-10-01' THEN DATE '2026-10-11'
    WHEN file_id = 'renamed' THEN DATE '2026-10-11'
  END AS reflection_end_date
FROM fixtures;
""")
    # Run the frozen PR #143 queries against the old physical schema first.
    baseline = (ROOT / "scripts/fixtures/retro-before-144.sql").read_text()
    for block in baseline.split("-- view: ")[1:]:
        name, query = block.split("\n", 1)
        if name == "retro_documents_legacy":
            name = "retro_documents"
        print(f"CREATE TEMP TABLE {name}_before AS\n{substitute_tables(query, before=True)};\n")
    print("CREATE TEMP TABLE chunks_before AS SELECT * FROM chunks;")
    rename_sql = runpy.run_path(str(ROOT / "scripts/retro-column-migration"))["rename_sql"]
    print(rename_sql("chunks"))
    for path, name in (
        ("iac/bigquery.tf", "chunks_current"),
        ("iac/silver_gold.tf", "silver_chunks"),
        ("iac/silver_gold.tf", "retro_documents"),
    ):
        print(f"CREATE TEMP TABLE {name} AS\n{view_query(path, name)};\n")
    # Compare row multiplicity too: retries in Raw must remain untouched.
    for name in ("chunks", "chunks_current", "silver_chunks", "retro_documents"):
        if name in ("chunks_current", "silver_chunks"):
            expected = f"SELECT * EXCEPT(reflection_month, reflection_sequence, reflection_start_date, reflection_end_date) FROM {name}_before"
        else:
            expected = f"""SELECT * EXCEPT(reflection_month, reflection_sequence, reflection_start_date, reflection_end_date),
              reflection_month AS retro_month, reflection_sequence AS retro_sequence,
              reflection_start_date AS retro_start_date, reflection_end_date AS retro_end_date
              FROM {name}_before"""
        # JSON STRUCTs use names/order. Sort columns explicitly on both sides.
        columns = {
            "chunks": "file_id, chunk_index, content, embedding_status, content_version, ingested_at, is_deleted, document_name, drive_url, retro_month, retro_sequence, retro_start_date, retro_end_date",
            "chunks_current": "file_id, chunk_index, content, embedding_status, content_version, ingested_at, document_name, drive_url, retro_month, retro_sequence, retro_start_date, retro_end_date",
            "silver_chunks": "file_id, chunk_index, content, content_version, ingested_at, document_name, drive_url, retro_month, retro_sequence, retro_start_date, retro_end_date, ingested_date, embedding_status, is_embedded, content_length",
            "retro_documents": "file_id, document_name, drive_url, content, content_version, ingested_at, retro_month, retro_sequence, retro_start_date, retro_end_date",
        }[name]
        print(f"""CREATE TEMP TABLE expected_{name} AS SELECT {columns} FROM ({expected});
CREATE TEMP TABLE actual_{name} AS SELECT {columns} FROM {name};
ASSERT NOT EXISTS (
  WITH expected AS (
    SELECT TO_JSON_STRING(t) AS row_value, COUNT(*) AS copies
    FROM expected_{name} t GROUP BY row_value
  ), actual AS (
    SELECT TO_JSON_STRING(t) AS row_value, COUNT(*) AS copies
    FROM actual_{name} t GROUP BY row_value
  )
  SELECT * FROM expected FULL OUTER JOIN actual USING (row_value)
  WHERE expected.copies IS DISTINCT FROM actual.copies
) AS '{name}: rename preserves all values, NULLs and duplicate counts';""")
    print(r"""
ASSERT (SELECT COUNT(*) = 5 AND COUNT(DISTINCT file_id) = 5 FROM retro_documents)
  AS 'one row per current nonempty file';
ASSERT (SELECT content = 'first\n\nsecond' AND content_version = 'v2'
  AND document_name = 'after' AND drive_url = 'after-url'
  AND retro_month = '2026-10' AND retro_sequence = 2
  AND retro_start_date = DATE '2026-10-12'
  AND retro_end_date = DATE '2026-10-18'
  AND ingested_at = TIMESTAMP('2026-10-03')
  FROM retro_documents WHERE file_id = 'renamed')
  AS 'ordered chunks, newest version, retry deduplication and metadata refresh';
ASSERT (SELECT COUNT(*) = 0 FROM retro_documents WHERE file_id = 'empty')
  AS 'empty tombstone suppresses previous body';
ASSERT (SELECT content = 'unknown month' AND retro_month IS NULL
  AND retro_sequence IS NULL AND document_name IS NULL AND drive_url IS NULL
  FROM retro_documents WHERE file_id = 'unknown')
  AS 'unknown month and nullable source remain in the view';
ASSERT (SELECT document_name IS NULL AND drive_url IS NULL
  AND retro_month IS NULL AND retro_sequence IS NULL
  AND retro_start_date IS NULL AND retro_end_date IS NULL
  FROM retro_documents WHERE file_id = 'cleared')
  AS 'new NULL metadata does not fall back to old values';
ASSERT (SELECT content = CONCAT(REPEAT('あ', 4000), '\n\ncontinuation')
  FROM retro_documents WHERE file_id = 'long')
  AS 'long Unicode chunks use the documented separator';
ASSERT (SELECT COUNT(*) = 0 FROM retro_documents
  WHERE file_id IN ('unknown', 'long')
    AND (retro_start_date IS NOT NULL OR retro_end_date IS NOT NULL))
  AS 'unknown exact periods are not inferred';
EXECUTE IMMEDIATE
  'SELECT COUNT(*) FROM retro_documents WHERE retro_month = @month'
  INTO month_count USING '2026-10' AS month;
ASSERT month_count = 2 AS 'parameterized month search excludes unknown months';
EXECUTE IMMEDIATE
  'SELECT COUNT(*) FROM retro_documents WHERE file_id = "renamed" AND retro_month = @month'
  INTO month_count USING '2026-09' AS month;
ASSERT month_count = 0 AS 'obsolete versions do not match month searches';

-- The predicate is the same for Silver chunks and Gold documents. Dates are
-- inclusive calendar dates in Japan, unrelated to ingestion timestamps.
EXECUTE IMMEDIATE '''
  SELECT COUNT(*) FROM retro_documents
  WHERE @query_start <= @query_end
    AND retro_start_date <= @query_end
    AND retro_end_date >= @query_start
''' INTO period_count
USING DATE '2026-10-01' AS query_start, DATE '2026-10-31' AS query_end;
ASSERT period_count = 2 AS 'October includes the September sprint crossing into October';
EXECUTE IMMEDIATE '''
  SELECT COUNT(*) FROM retro_documents
  WHERE @query_start <= @query_end
    AND retro_start_date <= @query_end
    AND retro_end_date >= @query_start
''' INTO period_count
USING DATE '2026-09-01' AS query_start, DATE '2026-09-30' AS query_end;
ASSERT period_count = 1 AS 'the crossing sprint also belongs in a September period search';
EXECUTE IMMEDIATE '''
  SELECT COUNT(*) FROM retro_documents
  WHERE @query_start <= @query_end
    AND retro_start_date <= @query_end
    AND retro_end_date >= @query_start
''' INTO period_count
USING DATE '2026-10-04' AS query_start, DATE '2026-10-04' AS query_end;
ASSERT period_count = 1 AS 'Sunday endpoint is inclusive';
EXECUTE IMMEDIATE '''
  SELECT COUNT(*) FROM retro_documents
  WHERE @query_start <= @query_end
    AND retro_start_date <= @query_end
    AND retro_end_date >= @query_start
''' INTO period_count
USING DATE '2026-10-05' AS query_start, DATE '2026-10-11' AS query_end;
ASSERT period_count = 0 AS 'superseded periods and adjacent weeks do not match';
EXECUTE IMMEDIATE '''
  SELECT COUNT(*) FROM retro_documents
  WHERE @query_start <= @query_end
    AND retro_start_date <= @query_end
    AND retro_end_date >= @query_start
''' INTO period_count
USING DATE '2026-10-12' AS query_start, DATE '2026-10-12' AS query_end;
ASSERT period_count = 1 AS 'Monday endpoint is inclusive';
EXECUTE IMMEDIATE '''
  SELECT COUNT(*) FROM retro_documents
  WHERE @query_start <= @query_end
    AND retro_start_date <= @query_end
    AND retro_end_date >= @query_start
''' INTO period_count
USING DATE '2026-10-18' AS query_start, DATE '2026-10-12' AS query_end;
ASSERT period_count = 0 AS 'reversed query ranges do not match';
ASSERT DATE(TIMESTAMP '2026-10-04 14:59:59+00', 'Asia/Tokyo') = DATE '2026-10-04'
   AND DATE(TIMESTAMP '2026-10-04 15:00:00+00', 'Asia/Tokyo') = DATE '2026-10-05'
  AS 'timestamp callers must use the Japanese midnight boundary';

""")
    print(rename_sql("chunks", rollback=True))
    print("""ASSERT NOT EXISTS (
  SELECT * FROM chunks EXCEPT DISTINCT SELECT * FROM chunks_before
) AND NOT EXISTS (
  SELECT * FROM chunks_before EXCEPT DISTINCT SELECT * FROM chunks
) AS 'rollback restores the original Raw schema and data';
SELECT 'All retro_documents assertions passed' AS result;""")


if __name__ == "__main__":
    # BigQuery script variables must be declared before table statements.
    sys.stdout.write("DECLARE month_count INT64;\nDECLARE period_count INT64;\n")
    main()
