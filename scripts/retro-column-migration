#!/usr/bin/env python3
"""Print Raw column rename SQL; never connect to or modify BigQuery."""

import argparse
import re

SUFFIXES = ("month", "sequence", "start_date", "end_date")


def rename_sql(table, rollback=False):
    # A qualified production table or an unqualified synthetic temporary table.
    if not re.fullmatch(r"[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_]+){0,2}", table):
        raise ValueError("Invalid table identifier")
    source, target = ("retro", "reflection") if rollback else ("reflection", "retro")
    columns = ",\n  ".join(
        f"RENAME COLUMN {source}_{suffix} TO {target}_{suffix}"
        for suffix in SUFFIXES
    )
    # Fail on an unexpected/partially migrated schema; do not silently skip it.
    return f"ALTER TABLE `{table}`\n  {columns};"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project", required=True)
    parser.add_argument("--dataset", required=True)
    parser.add_argument("--rollback", action="store_true")
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9_-]+", args.project):
        parser.error("Invalid project identifier")
    if not re.fullmatch(r"[A-Za-z0-9_]+", args.dataset):
        parser.error("Invalid dataset identifier")
    print(rename_sql(f"{args.project}.{args.dataset}.chunks", args.rollback))


if __name__ == "__main__":
    main()
