#!/usr/bin/env bash
# Smoke test for scripts/gh-pr-review. It stubs the GitHub API locally.
set -euo pipefail

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
test_dir=$(mktemp -d)
trap 'rm -rf "$test_dir"' EXIT

body_file="$test_dir/review.md"
fake_bin="$test_dir/bin"
mkdir "$fake_bin"

cat >"$body_file" <<'EOF'
## 結論
変更が必要です。

## 指摘
- **重要度:** high
- **対象:** `internal/record.go:42`
- **理由:** `recordID` が未設定です。https://example.com/design?source=pr-review
- **推奨対応:** `recordID` を検証してください。
EOF

cat >"$fake_bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

input_file=
while [[ $# -gt 0 ]]; do
  if [[ $1 == --input ]]; then
    input_file=$2
    shift 2
  else
    shift
  fi
done

jq '. + {id: 12345}' "$input_file"
EOF
chmod +x "$fake_bin/gh"

result=$(PATH="$fake_bin:$PATH" "$repository_root/scripts/gh-pr-review" \
  77 COMMENT "$body_file" qei-2027-700/go-drive-etl)
[[ $result == 'Published review #12345; body verified.' ]]
